                  }
                },
                "locale": "en-US"
              },
              "fields": {
                "title": "Fake useState",
                "code": "```js\nconst createFakeUseState = (\n  state: any[],\n  setters: Function[]\n) => {\n  let i = 0;\n  return( jest.fn(() => {\n  i++; \n  return ([state[i], setters[i]]);\n});\n```"
              }
            }
          }
        },
        {
          "nodeType": "paragraph",
          "content": [
            {
              "nodeType": "text",
              "value": "We can pull this all together in the following Jest unit test that will get us to be able to fully test our components!",
              "marks": [],
              "data": {}
            }
          ],
          "data": {}
        },
        {
          "nodeType": "embedded-entry-block",
          "content": [],
