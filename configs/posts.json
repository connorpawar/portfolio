                    "id": "codeBlock"
                  }
                },
                "locale": "en-US"
              },
              "fields": {
                "title": "Before Currying",
                "code": "```js\nconst Todolist = () => {\n  const [entries, setEntries] = useState([]);\n\n  useEffect(() => {\n    let response = await fetch(...);\n    setEntries(response)\n  }, [])\n\n  return(\n    <ul>\n    {entries.map((item) => <li>entry.name</li>)}\n    </ul>\n  );\n}\n```"
              }
            }
          }
        },
        {
          "nodeType": "paragraph",
          "content": [
            {
              "nodeType": "text",
              "value": "\n\nWhat if I told you that applying a simple tool, such as partial application through currying, could make this extremely straight forward to test?\n",
              "marks": [],
              "data": {}
            }
          ],
          "data": {}
        },
        {
          "nodeType": "embedded-entry-block",
          "content": [],
          "data": {
            "target": {
              "metadata": {
                "tags": [],
                "concepts": []
              },
              "sys": {
                "space": {
                  "sys": {
                    "type": "Link",
                    "linkType": "Space",
                    "id": "0j0b5js9hr3y"
                  }
                },
                "id": "48XD6p2833wYtImPBsfoPS",
                "type": "Entry",
                "createdAt": "2021-01-28T02:55:12.259Z",
                "updatedAt": "2021-01-28T02:55:12.259Z",
                "environment": {
                  "sys": {
                    "id": "master",
                    "type": "Link",
                    "linkType": "Environment"
                  }
                },
                "publishedVersion": 24,
                "revision": 1,
                "contentType": {
                  "sys": {
                    "type": "Link",
                    "linkType": "ContentType",
                    "id": "codeBlock"
                  }
                },
                "locale": "en-US"
              },
              "fields": {
                "title": "After Currying",
                "code": "```js\nconst makeTodolist = (IuseState ,IuseEffect) = function() {\n  const [entries, setEntries] = IuseState([]);\n\n  IuseEffect(() => {\n    let response = await fetch(...);\n    setEntries(response)\n  }, [])\n\n  return(\n    <ul>\n    {entries.map((item) => <li>entry.name</li>)}\n    </ul>\n  );\n}\n\nconst TodoList = makeTodoList(useState, useEffect);\n```"
              }
            }
          }
        },
        {
          "nodeType": "paragraph",
          "content": [
            {
              "nodeType": "text",
              "value": "\nWhile it might not be clear why this is useful, lets look at what exactly we have changed. Instead of immediately exporting the component, we are now making our component be the return of another function like a factory. This allows us to pass in the pesky or hard to mock functions as implementations (Using Typescript this allows you to type them exactly the same as far as intellisense is concearned).  \nYou are now able to more easily mock different implementations for your hooks across multiple tests using a mock of useState such as:\n",
              "marks": [],
              "data": {}
            }
          ],
          "data": {}
        },
        {
          "nodeType": "embedded-entry-block",
