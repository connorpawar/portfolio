                  }
                },
                "publishedVersion": 50,
                "revision": 1,
                "contentType": {
                  "sys": {
                    "type": "Link",
                    "linkType": "ContentType",
                    "id": "codeBlock"
                  }
                },
                "locale": "en-US"
              },
              "fields": {
                "title": "Hooks Unit Test",
                "code": "```js\ntest(\"Can render component\", () => {\n  const mockUseEffect = jest.fn(x => x());\n  const mockedSetter = jest.fn();\n  const mockUseState = createFakeUseState([\n    {name: 'test1'},\n    {name: 'test2'}],\n    [mockedSetter]);\n\n  const Component = makeTodoList(mockUseState, mockUseEffect);\n\n  const { getByText } = render(<Component />);\n\n  expect(getByText('test1')).toBeDefined();\n});\n```"
              }
            }
          }
        },
